{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "accent_color": "#69307A",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "dir_length": 3,
            "folder_separator_icon": "/",
            "style": "fish"
          },
          "template": "{{ if .Segments.Git.Dir }} \uf1d2 <i><b>{{ .Segments.Git.RepoName }}{{ if .Segments.Git.IsWorkTree }} \ue21c{{ end }}</b></i>{{ $rel := .Segments.Git.RelativeDir }}{{ if $rel }} \ueaf7 {{ .Format $rel }}{{ end }}{{ else }} \uea83 {{ path .Path .Location }}{{ end }} ",
          "foreground": "#EFDCF9",
          "background": "#4C1F5E",
          "powerline_symbol": "\ue0b4",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "branch_icon": "\ue0a0",
            "fetch_status": true
          },
          "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ nospace .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} ",
          "foreground": "#EFDCF9",
          "background": "#69307A",
          "powerline_symbol": "\ue0b4",
          "type": "git",
          "style": "powerline",
          "foreground_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FF3C3C{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}#42E66C{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#E4F34A{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "template": " \udb82\udfc9 {{ .Model.DisplayName }} \udb82\ude90 {{ .TokenGauge }} ",
          "foreground": "#EFDCF9",
          "background": "#4C1F5E",
          "powerline_symbol": "\ue0b6",
          "invert_powerline": true,
          "type": "claude",
          "style": "powerline",
          "foreground_templates": [
            "{{ if gt .TokenUsagePercent 90.0 }}#FF3C3C{{ end }}",
            "{{ if gt .TokenUsagePercent 75.0 }}#E4F34A{{ end }}"
          ]
        },
        {
          "template": "{{ if .FastMode }} \uf0e7{{ end }}{{ if .Effort }} {{ .Effort.Level }}{{ end }}{{ if and .Thinking .Thinking.Enabled }} \uf0eb{{ end }}{{ if and .OutputStyle (ne .OutputStyle.Name \"default\") }} {{ .OutputStyle.Name }}{{ end }}{{ if .Agent }} \uf0c0 {{ .Agent.Name }}{{ end }} ",
          "foreground": "#E4F34A",
          "background": "#69307A",
          "powerline_symbol": "\ue0b6",
          "invert_powerline": true,
          "type": "claude",
          "style": "powerline"
        },
        {
          "template": "{{ if or (gt .Cost.TotalLinesAdded 0) (gt .Cost.TotalLinesRemoved 0) }} <#42E66C>+{{ .Cost.TotalLinesAdded }}</> <#FF3C3C>-{{ .Cost.TotalLinesRemoved }}</> {{ end }}",
          "foreground": "#EFDCF9",
          "background": "#4C1F5E",
          "powerline_symbol": "\ue0b6",
          "invert_powerline": true,
          "type": "claude",
          "style": "powerline"
        },
        {
          "template": " {{ .FiveHourGauge }}{{ if gt .SevenDayUsage 75.0 }} 7d {{ .SevenDayUsage.String }}%{{ end }} ",
          "foreground": "#EFDCF9",
          "background": "#170B3B",
          "powerline_symbol": "\ue0b6",
          "invert_powerline": true,
          "type": "claude",
          "style": "powerline",
          "foreground_templates": [
            "{{ if or (gt .FiveHourUsage 90.0) (gt .SevenDayUsage 90.0) }}#FF3C3C{{ end }}",
            "{{ if or (gt .FiveHourUsage 75.0) (gt .SevenDayUsage 75.0) }}#E4F34A{{ end }}"
          ]
        },
        {
          "options": {
            "charged_icon": "\ue22f ",
            "charging_icon": "\ue234 ",
            "discharging_icon": "\ue231 "
          },
          "cache": {
            "duration": "10m",
            "strategy": "session"
          },
          "template": "{{ if not .Error }} {{ .Icon }}{{ .Percentage }}% {{ end }}",
          "foreground": "#EFDCF9",
          "background": "#4C1F5E",
          "powerline_symbol": "\ue0b6",
          "invert_powerline": true,
          "type": "battery",
          "style": "powerline",
          "foreground_templates": [
            "{{ if lt .Percentage 20 }}#FF3C3C{{ end }}",
            "{{ if eq \"Charging\" .State.String }}#42E66C{{ end }}",
            "{{ if eq \"Discharging\" .State.String }}#E4F34A{{ end }}"
          ]
        }
      ]
    }
  ],
  "version": 4
}
